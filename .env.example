APP_ENV=production
APP_BASE_URL=https://example.org
CADDY_DOMAIN=example.org
CADDY_DOMAINS=example.org
APP_TIMEZONE=Europe/Berlin
DATABASE_URL=sqlite:////data/app.db

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Use independent random values of at least 32 characters for each secret.
TOKEN_HMAC_KEY=
FINGERPRINT_HMAC_KEY=
SESSION_SECRET=
CSRF_SECRET=

ADMIN_USERNAME=admin
# Generate with SilentRelay's Argon2 helper; never store a clear-text password here.
ADMIN_PASSWORD_HASH=

ENTITLEMENT_PROVIDER=allow_all
ENTITLEMENT_PROVIDER_TIMEOUT_SECONDS=2
DEFAULT_LANGUAGE=en
DELIVERY_MAX_ATTEMPTS=6
HSTS_ENABLED=true
SECURE_COOKIES=true
SESSION_TTL_MINUTES=30
SCHEDULER_INTERVAL_SECONDS=60
LOG_LEVEL=INFO

# Persistent, privacy-preserving abuse protection. Values are POST attempts per window.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_ACCOUNT_CREATION_WINDOW_SECONDS=3600
RATE_LIMIT_ACCOUNT_CREATION_ATTEMPTS=3
RATE_LIMIT_CONTACT_CONFIRMATION_WINDOW_SECONDS=3600
RATE_LIMIT_CONTACT_CONFIRMATION_ATTEMPTS=10
RATE_LIMIT_NOTIFICATION_WINDOW_SECONDS=3600
RATE_LIMIT_NOTIFICATION_ATTEMPTS=10
RATE_LIMIT_MAX_BUCKETS=50000
