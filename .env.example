APP_ENV=production
APP_BASE_URL=https://example.org
CADDY_DOMAIN=example.org
CADDY_DOMAINS=example.org
APP_TIMEZONE=Europe/Berlin
DATABASE_URL=sqlite:////data/app.db

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Use independent random values of at least 32 characters for each secret.
TOKEN_HMAC_KEY=
FINGERPRINT_HMAC_KEY=
SESSION_SECRET=
CSRF_SECRET=

ADMIN_USERNAME=admin
# Generate with SilentRelay's Argon2 helper; never store a clear-text password here.
ADMIN_PASSWORD_HASH=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=SilentRelay

ACCOUNT_CREATION_ENABLED=true
DEFAULT_LANGUAGE=de
ACCOUNT_PENDING_RETENTION_DAYS=7
ACCOUNT_REVIEW_INTERVAL_DAYS=180
ACCOUNT_REVIEW_REMINDER_DAYS=-30,-15,-3,0,30
ACCOUNT_REVIEW_GRACE_DAYS=60
ACCOUNT_RETENTION_AFTER_DISABLE_DAYS=365
DELIVERY_MAX_ATTEMPTS=6
MESSAGE_RETENTION_HOURS=48
AUDIT_RETENTION_DAYS=90
HSTS_ENABLED=true
TRUSTED_PROXY_COUNT=0
SECURE_COOKIES=true
SESSION_TTL_MINUTES=30
SCHEDULER_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
